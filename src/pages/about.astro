---
import Page from '../layouts/Page.astro';

const stack = [
	{ k: 'Frontend', v: 'React, TypeScript, Vite, Vue' },
	{ k: 'Backend', v: 'Java 17, Spring Boot, MyBatis, Maven' },
	{ k: 'Database', v: 'SQL Server · 저장 프로시저 설계' },
	{ k: 'Infra', v: 'Linux(Rocky, Amazon Linux), nginx, systemd' },
	{ k: 'CI/CD', v: 'GitLab CI, Gitea Actions, GitHub Actions' },
];

const works = [
	{
		title: '8개 환경 배포 자동화',
		body: '두 개 리전의 dev·QA·라이브 백엔드·프론트 서비스를 버튼 배포로 전환했다. 운영 서버에는 배포 데몬을 두지 않고, 빌드 서버에서 SSH로 원격 배포하는 구조로 설계했다.',
		tags: ['GitLab CI', 'Gitea Actions', 'SSH'],
	},
	{
		title: '운영툴 신규 화면 개발',
		body: '운영자가 쓰는 화면을 저장 프로시저 설계부터 API, 프론트까지 한 흐름으로 만든다. 화면 구성은 하드코딩 대신 데이터 기준으로 묶는다.',
		tags: ['React', 'Spring Boot', 'SQL Server'],
	},
	{
		title: '웹서버 구축 표준화',
		body: 'java·nginx·systemd 구성을 표준형으로 정리하고, "장비 생존 / API 생존" 같은 목적에 따라 헬스체크 방식을 골라 쓰도록 패턴화했다.',
		tags: ['nginx', 'systemd', 'Linux'],
	},
	{
		title: 'BI 툴 인프라',
		body: '사내 BI 툴의 서버 구성과 배포, 운영을 맡고 있다. 무거운 쿼리에 맞춘 프록시 타임아웃 같은 운영 디테일을 챙긴다.',
		tags: ['Vue', 'nginx'],
	},
];
---

<Page title="About" description="운영툴과 배포 자동화를 만드는 웹개발자 suyeon">
	<section class="container head">
		<span class="eyebrow mono">$ cat ./about.md</span>
		<h1>suyeon</h1>
		<p class="lead">
			게임 회사에서 운영툴(GM 툴), BI 툴, 공식 홈페이지 같은 웹 서비스를 만들고 운영하는 웹개발자입니다.
			한 기능을 <strong>화면부터 서버까지</strong> 끝까지 책임지는 방식으로 일합니다.
		</p>
		<div class="links">
			<a class="btn" href="https://github.com/sychae2091" target="_blank" rel="noopener">GitHub ↗</a>
			<a class="btn" href="/blog/">글 보기 →</a>
		</div>
	</section>

	<section class="container block">
		<div class="section-head"><h2>Stack</h2></div>
		<div class="card table">
			{
				stack.map((s) => (
					<div class="tr">
						<span class="k mono">{s.k}</span>
						<span class="v">{s.v}</span>
					</div>
				))
			}
		</div>
	</section>

	<section class="container block">
		<div class="section-head"><h2>해 온 것들</h2></div>
		<ol class="timeline">
			{
				works.map((w) => (
					<li>
						<span class="node" aria-hidden="true" />
						<div class="card hoverable item">
							<h3>{w.title}</h3>
							<p>{w.body}</p>
							<div class="tags">
								{w.tags.map((t) => (
									<span class="tag">{t}</span>
								))}
							</div>
						</div>
					</li>
				))
			}
		</ol>
	</section>
</Page>

<style>
	.head {
		max-width: 820px;
		padding-top: 72px;
		padding-bottom: 24px;
	}
	h1 {
		margin-top: 12px;
		font-size: 52px;
		font-weight: 800;
		letter-spacing: -0.045em;
	}
	.lead {
		margin: 16px 0 0;
		font-size: 18px;
		color: var(--text-soft);
	}
	.lead strong {
		background: var(--grad);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}
	.links {
		display: flex;
		gap: 10px;
		margin-top: 26px;
	}
	.block {
		max-width: 820px;
		margin-top: 56px;
	}
	.table {
		overflow: hidden;
	}
	.tr {
		display: grid;
		grid-template-columns: 120px 1fr;
		gap: 16px;
		padding: 14px 20px;
		border-bottom: 1px solid var(--border);
	}
	.tr:last-child {
		border-bottom: none;
	}
	.k {
		font-size: 13px;
		color: var(--accent);
		padding-top: 2px;
	}
	.v {
		color: var(--text-soft);
	}
	.timeline {
		list-style: none;
		margin: 0;
		padding: 0 0 0 28px;
		position: relative;
		display: grid;
		gap: 14px;
	}
	.timeline::before {
		content: '';
		position: absolute;
		left: 6px;
		top: 10px;
		bottom: 10px;
		width: 1px;
		background: linear-gradient(var(--accent), var(--accent-2), transparent);
	}
	.timeline li {
		position: relative;
	}
	.node {
		position: absolute;
		left: -28px;
		top: 24px;
		width: 13px;
		height: 13px;
		border-radius: 50%;
		background: var(--bg);
		border: 2px solid var(--accent);
	}
	.item {
		padding: 20px 22px;
	}
	.item h3 {
		font-size: 18px;
	}
	.item p {
		margin: 8px 0 12px;
		color: var(--text-soft);
		font-size: 15.5px;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
	}
	@media (max-width: 640px) {
		h1 {
			font-size: 40px;
		}
		.tr {
			grid-template-columns: 1fr;
			gap: 2px;
		}
	}
</style>
