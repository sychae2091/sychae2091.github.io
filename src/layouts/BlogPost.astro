---
import type { MarkdownHeading } from 'astro';
import AdSlot from '../components/AdSlot.astro';
import SupportCard from '../components/SupportCard.astro';
import { MONETIZATION } from '../consts';
import { formatDate, readingMinutes, tagHref, tagsOf, type Post } from '../utils';
import Page from './Page.astro';

interface Props {
	post: Post;
	headings: MarkdownHeading[];
	newer?: Post;
	older?: Post;
}

const { post, headings, newer, older } = Astro.props;
const { title, description, pubDate, updatedDate, disclosure } = post.data;
const ads = MONETIZATION.adsense;
const tags = tagsOf(post);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<Page title={title} description={description} type="article">
	<div class="progress" slot="top" aria-hidden="true"><i id="read-progress"></i></div>

	<article class="container post">
		<header class="post-head">
			<a class="back mono" href="/blog/">← cd ../blog</a>
			{disclosure && <p class="disclosure">{disclosure}</p>}
			<div class="tags">
				{tags.map((t) => <a class="tag" href={tagHref(t)}>#{t}</a>)}
			</div>
			<h1>{title}</h1>
			<p class="desc">{description}</p>
			<div class="meta mono">
				<time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
				<span class="sep">/</span>
				<span>{readingMinutes(post)} min read</span>
				{
					updatedDate && (
						<>
							<span class="sep">/</span>
							<span>updated {formatDate(updatedDate)}</span>
						</>
					)
				}
			</div>
		</header>

		<div class="layout">
			<div class="prose" id="prose">
				<slot />
			</div>
			{
				(toc.length > 1 || ads.slotSidebar) && (
					<aside class="toc">
						{toc.length > 1 && (
							<div class="toc-inner">
								<span class="toc-title mono">// on this page</span>
								<ul>
									{toc.map((h) => (
										<li class={`d${h.depth}`}>
											<a href={`#${h.slug}`} data-slug={h.slug}>
												{h.text}
											</a>
										</li>
									))}
								</ul>
							</div>
						)}
						<div class="side-ad">
							<AdSlot slot={ads.slotSidebar} format="vertical" />
						</div>
					</aside>
				)
			}
		</div>

		<div class="after">
			<SupportCard />
			<AdSlot slot={ads.slotPostBottom} />
		</div>

		<nav class="pager">
			{
				older ? (
					<a class="card pg" href={`/blog/${older.id}/`}>
						<span class="mono">← 이전 글</span>
						<strong>{older.data.title}</strong>
					</a>
				) : (
					<span />
				)
			}
			{
				newer ? (
					<a class="card pg next" href={`/blog/${newer.id}/`}>
						<span class="mono">다음 글 →</span>
						<strong>{newer.data.title}</strong>
					</a>
				) : (
					<span />
				)
			}
		</nav>
	</article>
</Page>

<script>
	const bar = document.getElementById('read-progress');
	const prose = document.getElementById('prose');

	function onScroll() {
		if (!bar || !prose) return;
		const rect = prose.getBoundingClientRect();
		const total = rect.height - window.innerHeight * 0.6;
		const ratio = Math.min(1, Math.max(0, -rect.top / Math.max(total, 1)));
		bar.style.transform = `scaleX(${ratio})`;
	}
	window.addEventListener('scroll', onScroll, { passive: true });
	onScroll();

	document.querySelectorAll<HTMLPreElement>('#prose pre').forEach((pre) => {
		const wrap = document.createElement('div');
		wrap.className = 'code-block';
		const head = document.createElement('div');
		head.className = 'code-bar';
		const left = document.createElement('span');
		left.innerHTML = '<span class="lights"><i></i><i></i><i></i></span>';
		left.append(pre.dataset.language || 'text');
		const btn = document.createElement('button');
		btn.className = 'copy';
		btn.type = 'button';
		btn.textContent = 'copy';
		btn.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(pre.innerText);
				btn.textContent = 'copied ✓';
			} catch (e) {
				btn.textContent = 'failed';
			}
			setTimeout(() => (btn.textContent = 'copy'), 1600);
		});
		head.append(left, btn);
		pre.replaceWith(wrap);
		wrap.append(head, pre);
	});

	const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc a[data-slug]'));
	const targets = links
		.map((a) => document.getElementById(a.dataset.slug || ''))
		.filter((el): el is HTMLElement => !!el);
	if (targets.length) {
		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (!entry.isIntersecting) return;
					links.forEach((a) => a.classList.toggle('active', a.dataset.slug === entry.target.id));
				});
			},
			{ rootMargin: '-80px 0px -70% 0px' },
		);
		targets.forEach((t) => observer.observe(t));
	}
</script>

<style>
	.progress {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		height: 3px;
		z-index: 60;
	}
	.progress i {
		display: block;
		height: 100%;
		background: var(--grad);
		transform: scaleX(0);
		transform-origin: 0 50%;
		box-shadow: 0 0 12px var(--glow);
	}
	.post-head {
		max-width: 760px;
		padding-top: 64px;
		padding-bottom: 36px;
		margin-bottom: 40px;
		border-bottom: 1px solid var(--border);
	}
	.back {
		font-size: 13px;
		color: var(--muted);
	}
	.back:hover {
		color: var(--accent);
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		margin-top: 26px;
	}
	h1 {
		margin-top: 16px;
		font-size: clamp(30px, 4.4vw, 44px);
		line-height: 1.25;
		letter-spacing: -0.04em;
		font-weight: 800;
	}
	.desc {
		margin: 16px 0 0;
		font-size: 18px;
		color: var(--muted);
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		margin-top: 22px;
		font-size: 12.5px;
		color: var(--muted);
	}
	.sep {
		opacity: 0.4;
	}
	.layout {
		display: grid;
		grid-template-columns: minmax(0, 760px) 220px;
		gap: 64px;
		align-items: start;
	}
	.prose {
		min-width: 0;
	}
	.toc {
		position: sticky;
		top: 92px;
	}
	.toc-inner {
		padding-left: 18px;
		border-left: 1px solid var(--border);
	}
	.toc-title {
		font-size: 12px;
		color: var(--muted);
	}
	.toc ul {
		list-style: none;
		margin: 12px 0 0;
		padding: 0;
		display: grid;
		gap: 8px;
	}
	.toc li.d3 {
		padding-left: 12px;
	}
	.toc a {
		display: block;
		font-size: 13.5px;
		line-height: 1.45;
		color: var(--muted);
		transition: color 0.15s ease;
	}
	.toc a:hover,
	.toc a.active {
		color: var(--accent);
	}
	.disclosure {
		margin: 24px 0 0;
		padding: 10px 14px;
		border-radius: 10px;
		font-size: 14px;
		font-weight: 600;
		color: #b45309;
		background: rgba(245, 158, 11, 0.12);
		border: 1px solid rgba(245, 158, 11, 0.35);
	}
	:global(:root[data-theme='dark']) .disclosure {
		color: #fbbf24;
	}
	.side-ad {
		margin-top: 28px;
	}
	.side-ad:empty {
		display: none;
	}
	.after {
		display: grid;
		gap: 16px;
		max-width: 760px;
		margin-top: 72px;
	}
	.after:empty {
		display: none;
	}
	.pager {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 14px;
		max-width: 760px;
		margin-top: 32px;
	}
	.pg {
		display: grid;
		gap: 6px;
		padding: 18px 20px;
	}
	.pg span {
		font-size: 12px;
		color: var(--muted);
	}
	.pg strong {
		font-size: 15.5px;
		line-height: 1.45;
		color: var(--text);
	}
	.pg.next {
		text-align: right;
	}
	@media (max-width: 1080px) {
		.layout {
			grid-template-columns: minmax(0, 1fr);
		}
		.toc {
			display: none;
		}
	}
	@media (max-width: 640px) {
		.post-head {
			padding-top: 40px;
		}
		.pager {
			grid-template-columns: 1fr;
		}
		.pg.next {
			text-align: left;
		}
	}
</style>
