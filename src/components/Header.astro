---
import HeaderLink from './HeaderLink.astro';
---

<header class="site-header">
	<div class="container bar">
		<a href="/" class="logo mono" aria-label="홈">
			<span class="prompt">~/</span><span class="name">suyeon</span><span class="ext">.log</span><span
				class="caret"></span>
		</a>
		<nav class="links">
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/tags">Tags</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</nav>
		<div class="actions">
			<button class="search" type="button" data-open-palette aria-label="검색 열기">
				<svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"
					><path
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						d="M11 18a7 7 0 1 0 0-14 7 7 0 0 0 0 14Zm9 2-4-4"></path></svg
				>
				<span class="label">검색</span>
				<kbd class="mono">⌘K</kbd>
			</button>
			<button class="icon-btn" type="button" id="theme-toggle" aria-label="테마 전환">
				<svg class="sun" viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"
					><g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
						><circle cx="12" cy="12" r="4"></circle><path
							d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
						></path></g
					></svg
				>
				<svg class="moon" viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"
					><path
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linejoin="round"
						d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11Z"></path></svg
				>
			</button>
			<a class="icon-btn" href="https://github.com/sychae2091" target="_blank" rel="noopener" aria-label="GitHub">
				<svg viewBox="0 0 16 16" width="17" height="17" aria-hidden="true"
					><path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path></svg
				>
			</a>
		</div>
	</div>
</header>

<script>
	const toggle = document.getElementById('theme-toggle');
	toggle?.addEventListener('click', () => {
		const root = document.documentElement;
		const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
		root.setAttribute('data-theme', next);
		try {
			localStorage.setItem('theme', next);
		} catch (e) {}
	});
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		backdrop-filter: saturate(160%) blur(14px);
		-webkit-backdrop-filter: saturate(160%) blur(14px);
		background: color-mix(in srgb, var(--bg) 72%, transparent);
		border-bottom: 1px solid var(--border);
	}
	.bar {
		display: flex;
		align-items: center;
		gap: 20px;
		height: 60px;
	}
	.logo {
		display: inline-flex;
		align-items: center;
		font-size: 15.5px;
		font-weight: 700;
		letter-spacing: -0.02em;
		color: var(--text);
	}
	.logo .prompt {
		color: var(--accent-3);
	}
	.logo .ext {
		color: var(--muted);
		font-weight: 500;
	}
	.caret {
		display: inline-block;
		width: 8px;
		height: 17px;
		margin-left: 3px;
		background: var(--accent);
		animation: blink 1.1s steps(1) infinite;
	}
	@keyframes blink {
		50% {
			opacity: 0;
		}
	}
	.links {
		display: flex;
		gap: 2px;
	}
	.actions {
		display: flex;
		align-items: center;
		gap: 8px;
		margin-left: auto;
	}
	.search {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		height: 36px;
		padding: 0 8px 0 12px;
		border-radius: 9px;
		border: 1px solid var(--border-strong);
		background: var(--bg-elev);
		color: var(--muted);
		font: inherit;
		font-size: 14px;
		cursor: pointer;
		transition: border-color 0.15s ease, color 0.15s ease;
	}
	.search:hover {
		color: var(--text);
		border-color: var(--accent);
	}
	.search .label {
		min-width: 60px;
		text-align: left;
	}
	kbd {
		font-size: 11px;
		padding: 2px 6px;
		border-radius: 5px;
		border: 1px solid var(--border-strong);
		background: var(--bg-soft);
		color: var(--muted);
	}
	.icon-btn {
		display: inline-grid;
		place-items: center;
		width: 36px;
		height: 36px;
		border-radius: 9px;
		border: 1px solid transparent;
		background: transparent;
		color: var(--muted);
		cursor: pointer;
		transition: color 0.15s ease, background-color 0.15s ease;
	}
	.icon-btn:hover {
		color: var(--text);
		background: var(--bg-soft);
	}
	.moon {
		display: none;
	}
	:global(:root[data-theme='light']) .sun {
		display: none;
	}
	:global(:root[data-theme='light']) .moon {
		display: block;
	}
	@media (max-width: 720px) {
		.bar {
			gap: 8px;
		}
		.logo .ext,
		.search .label,
		.search kbd {
			display: none;
		}
		.search {
			padding: 0;
			width: 36px;
			justify-content: center;
		}
		.links :global(a) {
			padding: 0 8px;
			font-size: 14px;
		}
	}
	@media (max-width: 400px) {
		.logo .prompt {
			display: none;
		}
	}
</style>
