---
import { MONETIZATION } from '../consts';

interface Props {
	title?: string;
	text?: string;
}

const {
	title = '이 글이 도움이 됐다면',
	text = '커피 한 잔으로 다음 글을 응원해 주세요. 남겨 주신 후원은 더 깊게 파고드는 글을 쓰는 데 씁니다.',
} = Astro.props;

const s = MONETIZATION.support;
const links = [
	s.githubSponsors && { label: 'GitHub Sponsors', icon: '♥', href: `https://github.com/sponsors/${s.githubSponsors}` },
	s.buyMeACoffee && { label: 'Buy Me a Coffee', icon: '☕', href: `https://buymeacoffee.com/${s.buyMeACoffee}` },
	s.kofi && { label: 'Ko-fi', icon: '☕', href: `https://ko-fi.com/${s.kofi}` },
	s.tossMe && { label: '토스로 후원', icon: '₩', href: `https://toss.me/${s.tossMe}` },
	s.kakaoPay && { label: '카카오페이로 후원', icon: '₩', href: s.kakaoPay },
].filter(Boolean) as { label: string; icon: string; href: string }[];
---

{
	links.length > 0 && (
		<section class="support card">
			<div class="glow" aria-hidden="true" />
			<span class="eyebrow mono">// support</span>
			<h3>{title}</h3>
			<p>{text}</p>
			<div class="btns">
				{links.map((l, i) => (
					<a class:list={['btn', { primary: i === 0 }]} href={l.href} target="_blank" rel="noopener">
						<span aria-hidden="true">{l.icon}</span>
						{l.label}
					</a>
				))}
			</div>
		</section>
	)
}

<style>
	.support {
		position: relative;
		overflow: hidden;
		padding: 26px 26px 24px;
	}
	.glow {
		position: absolute;
		inset: -40% -10% auto auto;
		width: 360px;
		height: 260px;
		background: radial-gradient(closest-side, var(--glow), transparent);
		pointer-events: none;
	}
	h3 {
		margin-top: 8px;
		font-size: 20px;
	}
	p {
		margin: 8px 0 18px;
		max-width: 560px;
		font-size: 15px;
		color: var(--muted);
	}
	.btns {
		position: relative;
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}
	.btn {
		height: 40px;
		font-size: 14px;
	}
</style>
