---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '/');
const first = pathname.match(/[^\/]+/g)?.[0] ?? '';
const isActive = href === pathname || href === '/' + first;
---

<a href={href} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>
<style>
	a {
		position: relative;
		display: inline-flex;
		align-items: center;
		height: 34px;
		padding: 0 12px;
		border-radius: 8px;
		font-size: 14.5px;
		font-weight: 500;
		color: var(--muted);
		transition: color 0.15s ease, background-color 0.15s ease;
	}
	a:hover {
		color: var(--text);
		background: var(--bg-soft);
	}
	a.active {
		color: var(--text);
	}
	a.active::after {
		content: '';
		position: absolute;
		left: 12px;
		right: 12px;
		bottom: -13px;
		height: 2px;
		border-radius: 2px;
		background: var(--grad);
	}
</style>
